## NEXTFLOW command
for f in $inputFolder/*_1.fastq.gz
do
SAMPLE=$(echo ${f} | sed "s/_1\.fastq\.gz//")
SAMPLE_pe="${SAMPLE}_{1,2}.fastq.gz"
filename="${SAMPLE##*/}"
runName="Interpaleogen_16102023_${filename}"
results="$resultsfolder/results_Interpaleogen_PR2_16102023_MdH_${filename}/"
workdir="/data/mpb/bourreau/eager/test/work_PR2_16102023_MdH_INTERPALEOGEN_${filename}/"
nextflow run eager_2.4.6 -c $configFile  -profile singularity -resume $runName \
--max_cpus $cpuLimit \
--max_memory $memLimit \
--input $SAMPLE_pe \
--fasta $refFastaFile \
--colour_chemistry 2 \
--save_reference \
--outdir $results \
-w $workdir \
--complexity_filter_poly_g \
--clip_readlength 25 \
--preserve5p \
--mergedonly \
--dedupper 'dedup' \
--mapper 'bowtie2' \
--bt2_alignmode 'local' \
--bt2_sensitivity 'sensitive' \
--run_bam_filtering \
--bam_mapping_quality_threshold 0 \
--bam_unmapped_type 'discard' \

## Deletion of intermediate files
nextflow clean -f -k
done
 
  